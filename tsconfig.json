{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "js",
    "rootDir": "src",
    "strict": false,
    "alwaysStrict": true,
    "noImplicitAny": false,
    "removeComments": false,
    "sourceMap": false,
    "newLine": "lf"
  },
  "include": ["src/*.ts"]
}
